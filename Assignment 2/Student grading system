#include <stdio.h>
#include <stdlib.h>

int main()
{
    int marks;

    printf("Please enter your marks");
    scanf("%d", &marks);

    if (marks >= 70)
    {
        printf("Grade A");
    }
    else if (marks >=60)
    {
        printf("Grade B");
    }
    else if (marks >=50)
    {
        printf("Grade C");
    }
    else if (marks >=40)
    {
        printf("Grade D");
    }
    else
    {
        printf("Grade E");
    }

    return 0;
}
