#include <stdio.h>
#include <stdlib.h>

int main()
{   float a, b, result;
    char operation;

    printf("simple calculator\n");

    printf("Enter first number:");
    scanf("%f", &a);

    printf("Enter an operator (+, -, *, /):");
    scanf(" %c", &operation);

    printf("Enter second number: ");
    scanf("%f", &b);

    switch (operation)
    {
        case '+':
            result = a + b;
            printf("Result = %.2f\n", result);
            break;

        case '-':
            result = a - b;
            printf("Result = %.2f\n", result);
            break;

        case '*':
            result = a * b;
            printf("Result = %.2f\n", result);
            break;

        case '/':
            if (b != 0)
            {
                result = a / b;
                printf("Result = %.2f\n", result);
            }
            else
            {
                printf("Error! Division by zero is not allowed.\n");
            }
            break;

        default:
            printf("Invalid operator!\n");
    }

    return 0;
}
