#include <stdio.h>
#include <stdlib.h>

// Function declarations
int login();
void checkBalance();
void deposit(float amount);
void withdraw(float amount);

// Global variables
int pin = 1234;
float balance = 10000;

// Main function
int main()
{
    int choice;
    float amount;

    if (login() == 1)
    {
        do
        {
            printf("\n===== ATM MENU =====\n");
            printf("1. Balance Inquiry\n");
            printf("2. Deposit\n");
            printf("3. Withdraw\n");
            printf("4. Exit\n");

            printf("Enter your choice: ");
            scanf("%d", &choice);

            if (choice == 1)
            {
                checkBalance();
            }
            else if (choice == 2)
            {
                printf("Enter amount to deposit: ");
                scanf("%f", &amount);

                if (amount > 0)
                {
                    deposit(amount);
                }
                else
                {
                    printf("Invalid amount. Enter a positive number.\n");
                }
            }
            else if (choice == 3)
            {
                printf("Enter amount to withdraw: ");
                scanf("%f", &amount);

                if (amount > 0)
                {
                    withdraw(amount);
                }
                else
                {
                    printf("Invalid amount. Enter a positive number.\n");
                }
            }
            else if (choice == 4)
            {
                printf("Thank you for using our ATM.\n");
            }
            else
            {
                printf("Invalid choice. Try again.\n");
            }

        } while (choice != 4);
    }

    return 0;
}

// Function definitions

int login()
{
    int enteredPin;
    int attempts = 0;

    while (attempts < 3)
    {
        printf("Enter your PIN: ");
        scanf("%d", &enteredPin);

        if (enteredPin == pin)
        {
            printf("Login successful!\n");
            return 1;
        }
        else
        {
            attempts++;
            printf("Incorrect PIN. Attempts remaining: %d\n", 3 - attempts);
        }
    }

    printf("Maximum attempts exceeded. Access denied.\n");
    return 0;
}

